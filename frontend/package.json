{
  "name": "mantine-vite-template",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev2back": "VITE_BACKEND_PORT=8000 vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint . --cache",
    "eslint:fix": "eslint . --fix --cache",
    "stylelint": "stylelint '**/*.css' --cache",
    "stylelint:fix": "stylelint '**/*.css' --fix --cache",
    "prettier": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@mantine/core": "9.5.1",
    "@mantine/dates": "9.5.1",
    "@mantine/form": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@mantine/tiptap": "9.5.1",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tiptap/extension-link": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "axios": "1.19.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.22",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@storybook/react": "10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@tanstack/router-plugin": "1.168.32",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-mantine": "4.0.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "identity-obj-proxy": "3.0.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.6",
    "prop-types": "15.8.1",
    "storybook": "10.5.8",
    "storybook-dark-mode": "5.0.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0"
    }
  }
